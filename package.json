{
  "name": "bodegix-pos",
  "version": "0.1.0",
  "private": true,
  "description": "PWA offline-first de ventas, caja e inventario para bodegas.",
  "packageManager": "pnpm@11.20.0",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build && node scripts/sync-pwa-nitro-assets.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:architecture": "vitest run src/test/architecture/arch.test.ts",
    "test:performance": "playwright test --config=playwright.performance.config.ts",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:build": "pnpm build && playwright test",
    "test:pwa": "pnpm build && playwright test --config=playwright.pwa.config.ts",
    "test:pwa:headed": "pnpm build && playwright test --config=playwright.pwa.config.ts --headed",
    "test:a11y": "playwright test --config=playwright.a11y.config.ts",
    "test:smoke": "playwright test --config=playwright.release.config.ts",
    "check:bundle": "node scripts/check-bundle.mjs",
    "security:audit": "pnpm audit --audit-level=high",
    "seed:demo:backup": "node scripts/create-demo-seed-backup.mjs",
    "release:artifacts": "node scripts/generate-release-artifacts.mjs",
    "release:check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:performance && pnpm check:bundle && pnpm test:e2e && pnpm test:pwa && pnpm test:a11y && pnpm test:smoke && pnpm security:audit",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "check:full": "pnpm check && pnpm test:e2e && pnpm test:pwa"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@t3-oss/env-core": "^0.13.10",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-form": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dexie": "^4.4.4",
    "dexie-export-import": "4.4.0",
    "dexie-react-hooks": "^4.4.0",
    "next-themes": "^0.4.6",
    "nitro": "3.0.260610-beta",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-resizable-panels": "^4.12.2",
    "shadcn": "^4.16.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "temporal-polyfill": "1.0.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "2.4.5",
    "@playwright/test": "^1.62.1",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^3.2.0",
    "cross-env": "^10.1.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "nitro": "3.0.260610-beta",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7",
    "workbox-window": "^7.4.1"
  }
}
